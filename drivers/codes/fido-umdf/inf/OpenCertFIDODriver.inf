; OpenCertFIDODriver.inf
; OpenCert FIDO2 虚拟 SmartCardReader UMDF 驱动安装信息文件
;
; 设备类：SmartCardReader
; 驱动类型：UMDF2（用户态驱动框架 v2）
; 硬件 ID：ROOT\OPENCERTFIDO
;
; 安装后效果：
;   - 设备管理器中出现 "OpenCert FIDO2 Virtual Reader"
;   - SCardListReaders() 可枚举到 "OpenCert FIDO2 Virtual Reader 0"
;   - Windows WebAuthn API 可通过此读卡器进行 FIDO2 认证
;
; 签名要求：
;   - 需要 EV 代码签名证书（已有）
;   - 使用 signtool.exe 对 .cat 文件签名
;   - 使用 inf2cat.exe 生成 .cat 文件

[Version]
Signature   = "$WINDOWS NT$"
Class       = SmartCardReader
ClassGuid   = {50DD5230-BA8A-11D1-BF5D-0000F805F530}
Provider    = %ManufacturerName%
DriverVer   = 06/02/2025,1.0.0.1
CatalogFile = OpenCertFIDODriver.cat
PnpLockdown = 1

; ================================================================
; 制造商和型号
; ================================================================
[Manufacturer]
%ManufacturerName% = Standard, NTamd64, NTx86

[Standard.NTamd64]
%DeviceDesc% = OpenCertFIDO_Install, ROOT\OPENCERTFIDO

[Standard.NTx86]
%DeviceDesc% = OpenCertFIDO_Install, ROOT\OPENCERTFIDO

; ================================================================
; 安装节（x64 和 x86 共用）
; ================================================================
[OpenCertFIDO_Install.NT]
CopyFiles = OpenCertFIDO_CopyFiles

[OpenCertFIDO_Install.NT.hw]
AddReg = OpenCertFIDO_HwReg

[OpenCertFIDO_Install.NT.Services]
AddService = WUDFRd, 0x000001fa, WUDFRD_ServiceInstall

[OpenCertFIDO_Install.NT.Wdf]
UmdfService              = OpenCertFIDODriver, OpenCertFIDO_UmdfInstall
UmdfServiceOrder         = OpenCertFIDODriver
UmdfKernelModeClientPolicy = AllowKernelModeClients
UmdfFileObjectPolicy     = AllowNullAndUnknownFileObjects
UmdfFsContextUsePolicy   = CannotUseFsContexts

; ================================================================
; UMDF 服务安装
; ================================================================
[OpenCertFIDO_UmdfInstall]
UmdfLibraryVersion = 2.33.0
ServiceBinary      = %12%\UMDF\OpenCertFIDODriver.dll
UmdfImpersonationLevel = Identification

; ================================================================
; WUDFRd 内核服务（UMDF 宿主进程）
; ================================================================
[WUDFRD_ServiceInstall]
DisplayName    = %WudfRdDisplayName%
ServiceType    = 1
StartType      = 3
ErrorControl   = 1
ServiceBinary  = %12%\WUDFRd.sys

; ================================================================
; 硬件注册表项
; ================================================================
[OpenCertFIDO_HwReg]
; 设置读卡器友好名称（PC/SC 框架使用）
HKR,,"FriendlyName",,%ReaderFriendlyName%
; 标记为虚拟设备
HKR,,"VirtualDevice",0x00010001,1
; UMDF 独占访问模式（SmartCardReader 类驱动要求）
HKR,"WUDF","Exclusive",0x00010001,1

; ================================================================
; 文件复制
; ================================================================
[OpenCertFIDO_CopyFiles]
OpenCertFIDODriver.dll

[DestinationDirs]
OpenCertFIDO_CopyFiles = 12,UMDF  ; %SystemRoot%\System32\drivers\UMDF\

; ================================================================
; 源文件位置
; ================================================================
[SourceDisksNames]
1 = %DiskName%,,,""

[SourceDisksFiles]
OpenCertFIDODriver.dll = 1

; ================================================================
; 字符串定义
; ================================================================
[Strings]
ManufacturerName    = "GlobalTrusts"
DeviceDesc          = "OpenCert FIDO2 Virtual SmartCard Reader"
ReaderFriendlyName  = "OpenCert FIDO2 Virtual Reader 0"
DiskName            = "OpenCert FIDO2 Driver Installation Disk"
WudfRdDisplayName   = "Windows Driver Foundation - User-mode Driver Framework Reflector"
