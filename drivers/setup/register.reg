Windows Registry Editor Version 5.00

; ============================================================
; OpenCert PKCS#11 智能卡微型驱动程序 - 注册表导入文件
; 参考: https://learn.microsoft.com/zh-cn/windows-hardware/drivers/smartcard/minidriver-registration
;
; 注意: 使用前请先将 DLL 复制到 C:\Windows\System32\
;       或运行 install.bat 自动完成所有步骤
; ============================================================

; ---- 智能卡微型驱动程序注册 (Calais\SmartCards) ----
; 这是 Windows 智能卡基础 CSP/KSP 识别卡片的关键注册项
[HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Cryptography\Calais\SmartCards\Pikachu Secure SmartCard]
; ATR (Answer To Reset) - 虚拟智能卡标识字节
"ATR"=hex:3b,88,80,01,50,4b,43,53,31,31,00,7a
; ATR 掩码 - 用于匹配 ATR 的位掩码
"ATRMask"=hex:ff,ff,ff,ff,ff,ff,ff,ff,ff,ff,ff,ff
; 基础加密服务提供程序
"Crypto Provider"="Microsoft Base Smart Card Crypto Provider"
; 密钥存储提供程序
"Smart Card Key Storage Provider"="Microsoft Smart Card Key Storage Provider"
; 80000001 - 微型驱动程序 DLL 文件名（必须位于 System32）
"80000001"="PikachuMD.dll"

; ---- CSP 注册 ----
[HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Cryptography\Defaults\Provider\Pikachu SmartCard Crypto Provider]
"Image Path"="C:\\Windows\\System32\\PikachuMD.dll"
"Type"=dword:00000001
"SigInFile"=dword:00000000

; ---- PKCS#11 模块路径（供应用程序发现）----
[HKEY_LOCAL_MACHINE\SOFTWARE\OpenCert\PKCS11]
"ModulePath"="C:\\Windows\\System32\\pkcs11-mock-x64.dll"
"MiniDriverPath"="C:\\Windows\\System32\\PikachuMD.dll"
"Manufacturer"="Pikachu SmartCard MiniDriver"
"CardName"="Pikachu Secure SmartCard"
"Version"="2.1.0"
